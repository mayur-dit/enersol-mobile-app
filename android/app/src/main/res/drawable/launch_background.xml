<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start splash: shown by the window manager until Flutter draws its
     first frame. White ground, because the bulb mark is drawn at ~70% opacity
     and is built for a light background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
